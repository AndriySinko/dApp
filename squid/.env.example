# Required after contract deployment
FACTORY_ADDRESS=0x...
GOVERNANCE_ADDRESS=0x...
REPUTATION_ADDRESS=0x...

# Sepolia RPC (Alchemy or Infura free tier)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Block number of first factory deployment (reduces sync time)
START_BLOCK=0

# Subsquid managed Postgres (set automatically in cloud deploy)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
